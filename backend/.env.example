# Backend Environment Configuration
# For production (Darkube), set these environment variables in the Darkube Dashboard

# ⚠️ CRITICAL: Must be set in Darkube Dashboard
DATABASE_URL=postgresql://username:password@postgres.host:5432/hamsohbat

# Admin Credentials (must be set in Darkube Dashboard)
ADMIN_PHONE=09052893115
ADMIN_PASSWORD=138727127138727127
ADMIN_NAME=محمد مهدی
ADMIN_USERNAME=admin

# ============================================
#  SMS Service Configuration (IPPanel / Faraz SMS)
#  👉 «توکن پیامک» در متغیر SMS_API_KEY قرار می‌گیرد
# ============================================
# توکن/کلید API پنل پیامک
SMS_API_KEY=
# نام کاربری و رمز پنل (روش قدیمی احراز هویت)
SMS_USERNAME=
SMS_PASSWORD=
# شمارهٔ خط خدماتی (Originator)
SMS_ORIGINATOR=
# کد پترن تأییدشده در پنل
SMS_PATTERN_CODE=
# نام متغیر داخل پترن (در پترن شما «code» است)
SMS_PATTERN_VARIABLE=code
SMS_API_URL=https://ippanel.com/patterns/pattern

# App Settings
OTP_EXPIRY_SECONDS=120
OTP_LENGTH=6

# ============================================
# 🚀 DARKUBE DEPLOYMENT INSTRUCTIONS
# ============================================
#
# 1. Go to Darkube Dashboard: https://darkube.ir
#
# 2. In the Backend Service environment variables:
#    Add all the variables above EXCEPT database URL defaults
#
# 3. For DATABASE_URL, choose ONE option (طرح postgres:// هم پذیرفته می‌شود):
#
#    Option A: Supabase (PostgreSQL)
#    DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres
#
#    Option B: Railway
#    DATABASE_URL=postgresql://user:password@postgres.railway.internal:5432/hamsohbat
#
#    Option C: Render
#    DATABASE_URL=postgresql://user:password@dpg-xxxxx.render.com:5432/hamsohbat
#
# 4. After setting environment variables, redeploy the service
#
# 5. Check logs for "جداول دیتابیس با موفقیت ایجاد/تأیید شدند."
#
# ============================================
# 📝 Health Check
# ============================================
# curl https://your-backend-url/api/health
# Expected response: {"status":"ok","app":"Daftar Goftogu","database":"up"}
# ============================================
